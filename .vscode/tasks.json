{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-Start RSR Preview",
      "type": "shell",
      "command": "npm install && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(vite|Local:).*",
          "endsPattern": ".*(ready in|http).*"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
